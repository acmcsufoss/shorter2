{
  "name": "@shorter2/service",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "module": "src/index.ts",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy -e production",
    "dev": "wrangler dev --port 8788",
    "start": "wrangler dev",
    "migrate": "bun scripts/migrate.ts",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check ./src",
    "check:write": "biome check --write ./src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shorter2/types": "workspace:*",
    "chanfana": "^3.3.0",
    "hono": "^4.13.2",
    "qrcode-svg": "^1.1.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "22.13.0",
    "@types/qrcode-svg": "^1.1.5",
    "@types/service-worker-mock": "^2.0.4",
    "vitest": "~3.2.7",
    "wrangler": "^4.123.0"
  }
}
